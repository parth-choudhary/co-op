# Optional — agent run tracing (M1 P1 / RUN-06).
# Set these to enable Langfuse SDK tracing of every Anthropic/OpenAI/CLI call.
# For self-hosted: see docker-compose.yml — the langfuse-* services bootstrap
# an admin user and a "Co-Op Dev" project on first boot using LANGFUSE_INIT_*.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=http://localhost:3001

# Self-hosted Langfuse bootstrap (consumed on first DB boot, ignored after).
# LANGFUSE_INIT_ORG_ID=co-op
# LANGFUSE_INIT_ORG_NAME=Co-Op
# LANGFUSE_INIT_PROJECT_ID=co-op-dev
# LANGFUSE_INIT_PROJECT_NAME="Co-Op Dev"
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-...   # match LANGFUSE_PUBLIC_KEY above
# LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-...   # match LANGFUSE_SECRET_KEY above
# LANGFUSE_INIT_USER_EMAIL=you@example.com
# LANGFUSE_INIT_USER_NAME=Admin
# LANGFUSE_INIT_USER_PASSWORD=                  # generate via `openssl rand -base64 18`

# Self-hosted Langfuse service secrets (generate via `openssl rand`).
# `scripts/setup.sh` populates all of these on first run; values below are
# only the format hints if you wish to bring up the stack by hand.
# LANGFUSE_NEXTAUTH_SECRET=                     # openssl rand -base64 32
# LANGFUSE_SALT=                                # openssl rand -hex 16
# LANGFUSE_ENCRYPTION_KEY=                      # openssl rand -hex 32 (must be 64 hex chars)
# LANGFUSE_POSTGRES_PASSWORD=                   # openssl rand -hex 16
# LANGFUSE_CLICKHOUSE_PASSWORD=                 # openssl rand -hex 16
# LANGFUSE_REDIS_AUTH=                          # openssl rand -hex 16
# LANGFUSE_MINIO_ROOT_PASSWORD=                 # openssl rand -hex 16  (also used as the S3 secret access key)

# Optional — OTel exporter for raw GenAI spans. Compatible with Honeycomb,
# Tempo, Langfuse OTLP endpoint, Jaeger via collector, etc.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=co-op

# Optional — agent memory embeddings (Memory v1, pre-M1).
# When set, AgentMemory + ProjectMemory rows get embedded with
# text-embedding-3-small on write and compileHarness uses cosine retrieval
# to surface only relevant memories. When unset, the harness falls back to
# load-everything (the pre-vector behavior).
# OPENAI_API_KEY=
